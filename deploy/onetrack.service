[Unit]
Description=OneTrack Flask Application
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/onetrack
Environment="PATH=/home/ubuntu/onetrack/venv/bin"
ExecStart=/home/ubuntu/onetrack/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
